(footprint "D_DO-41_SOD81_P10p16_Horizontal" (layer "F.Cu") (attr through_hole)
 (descr "DO-41 1N5819 Schottky, horizontal, 10.16 mm pitch. Pin 1=cathode band, pin 2=anode.")
 (fp_text reference "REF**" (at 5.08 -3.5) (layer "F.SilkS") (effects (font (size 0.9 0.9) (thickness 0.14))))
 (fp_text value "1N5819" (at 5.08 3.5) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12))))
 (fp_rect (start 2.4 -1.45) (end 7.75 1.45) (stroke (width 0.12) (type solid)) (fill none) (layer "F.Fab"))
 (fp_line (start 2.85 -1.45) (end 2.85 1.45) (stroke (width 0.3) (type solid)) (layer "F.SilkS"))
 (fp_rect (start -1.9 -2.0) (end 12.05 2.0) (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
 (pad "1" thru_hole rect (at 0 0) (size 2.0 2.0) (drill 1.0) (layers "*.Cu" "*.Mask"))
 (pad "2" thru_hole circle (at 10.16 0) (size 2.0 2.0) (drill 1.0) (layers "*.Cu" "*.Mask"))
)
