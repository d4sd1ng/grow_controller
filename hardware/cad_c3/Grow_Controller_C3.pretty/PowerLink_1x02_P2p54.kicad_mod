(footprint "PowerLink_1x02_P2p54" (layer "F.Cu") (attr through_hole)
  (descr "2-pin 2.54mm service shunt, manual 5V buck-to-C3 disconnect; remove link before USB connection")
  (fp_text reference "REF**" (at 1.27 -3.2) (layer "F.SilkS") (effects (font (size 0.85 0.85) (thickness 0.14))))
  (fp_text value "SERVICE_POWER_LINK" (at 1.27 3.4) (layer "F.Fab") (effects (font (size 0.75 0.75) (thickness 0.12))))
  (fp_rect (start -1.7 -1.6) (end 4.24 1.6) (stroke (width 0.12) (type solid)) (fill none) (layer "F.Fab"))
  (fp_rect (start -2.1 -2.05) (end 4.64 2.05) (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
  (pad "1" thru_hole rect (at 0 0) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
  (pad "2" thru_hole circle (at 2.54 0) (size 1.7 1.7) (drill 1.0) (layers "*.Cu" "*.Mask"))
)
