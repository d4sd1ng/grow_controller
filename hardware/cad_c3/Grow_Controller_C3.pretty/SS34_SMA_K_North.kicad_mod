(footprint "SS34_SMA_K_North" (layer "F.Cu") (attr smd)
(descr "SS34 Schottky 3A 40V SMA(DO-214AC) cathode at top, pin1 K top, pin2 A bottom; diode candidate")
(fp_text reference "REF**" (at -3.2 0) (layer "F.SilkS") (effects (font (size 0.85 0.85) (thickness 0.12))))
(fp_text value "SS34" (at 3.2 0) (layer "F.Fab") (effects (font (size 0.7 0.7) (thickness 0.12))))
(fp_rect (start -2.25 -3.65) (end 2.25 3.65) (stroke (width 0.05) (type default)) (fill none) (layer "F.CrtYd"))
(fp_rect (start -1.5 -2.0) (end 1.5 2.0) (stroke (width 0.1) (type solid)) (fill none) (layer "F.Fab"))
(fp_line (start -1.45 -3.65) (end 1.45 -3.65) (stroke (width 0.25) (type solid)) (layer "F.SilkS"))
(pad "1" smd rect (at 0 -2.45) (size 2.2 1.7) (layers "F.Cu" "F.Paste" "F.Mask"))
(pad "2" smd rect (at 0 2.45) (size 2.2 1.7) (layers "F.Cu" "F.Paste" "F.Mask"))
)
