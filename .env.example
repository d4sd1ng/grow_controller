# Copy to `.env` (never commit `.env`). Revoke any token that was ever committed.
#
# --- Sensible Daten nur hier (Python + optionale Firmware-Erzeugung) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_numeric_chat_id

# Telemetry HTTP API (ESP32/CYD → Server). Wenn gesetzt: Header X-Telemetry-Key erforderlich.
TELEMETRY_API_KEY=
LKBOuUUqXWJec0QpK2UoJJlDK3I5QZf7SZhoEut4AVg=
TELEMETRY_API_PORT=8765
TELEMETRY_API_HOST=0.0.0.0
# TELEMETRY_CORS_ORIGINS=*
# TELEMETRY_API_RELOAD=0

# SQLite telemetry (optional overrides)
# GROW_DATA_DB=data/grow_telemetry.db
# GROW_DATA_RETENTION_DAYS=90

# ESP32 / CYD: für `python export_firmware_secrets_from_env.py` → device_secrets.h im Sketch-Ordner
# IOT_WIFI_SSID=
# IOT_WIFI_PASSWORD=
# IOT_TELEMETRY_SERVER_HOST=
# VPS mit HTTPS-Proxy: IOT_USE_HTTPS=1, IOT_TELEMETRY_SERVER_PORT=443 (Standard bei HTTPS ohne expliziten Port)
# IOT_TLS_INSECURE=1  ← ESP32 prüft kein Zertifikat (MITM möglich); 0 = später mit setCACert() o. Ä.
# IOT_USE_HTTPS=0
