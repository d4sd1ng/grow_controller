# Grow Controller Environment Configuration
# Copy this file to .env and fill in your values

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telemetry API
TELEMETRY_API_HOST=0.0.0.0
TELEMETRY_API_PORT=8765
TELEMETRY_API_KEY=
TELEMETRY_CORS_ORIGINS=*

# Database -- current SQLite interim state.
# Replaced by PostgreSQL settings in the next migration step.
GROW_DATA_DB=data/grow_telemetry.db
GROW_DATA_RETENTION_DAYS=90

# Firmware WiFi / server settings used by export_firmware_secrets_from_env.py
IOT_WIFI_SSID=
IOT_WIFI_PASSWORD=
IOT_TELEMETRY_SERVER_HOST=
# Optional override; default is TELEMETRY_API_PORT (or 443 with HTTPS)
IOT_TELEMETRY_SERVER_PORT=
IOT_USE_HTTPS=0
IOT_TLS_INSECURE=0

# Sensor-ESP local API for Dashboard/FastAPI control forwarding.
# Use a fixed DHCP IP or resolvable hostname (for example grow-sensor.local).
IOT_SENSOR_HOST=
IOT_SENSOR_PORT=8081
IOT_API_KEY=

# Dashboard Auth
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
