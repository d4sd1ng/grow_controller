# Grow Controller Environment Configuration
# Copy this file to .env and fill in your values

# Telegram Bot (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Telemetry API
TELEMETRY_API_HOST=0.0.0.0
TELEMETRY_API_PORT=8765
# Set a strong random key for API authentication (required for production)
TELEMETRY_API_KEY=
TELEMETRY_CORS_ORIGINS=*

# Database
# SQLite path (default: data/grow_telemetry.db)
GROW_DATA_DB=data/grow_telemetry.db
# Data retention in days (default: 90)
GROW_DATA_RETENTION_DAYS=90

# ESP32 IoT Sensors (optional, for real hardware)
IOT_SENSOR_HOST=
IOT_SENSOR_PORT=
IOT_API_KEY=

# Dashboard Auth (change these!)
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=


# ESP32 / CYD: only fill these in YOUR LOCAL .env, never commit it
# Wi-Fi credentials (used when generating firmware/**/device_secrets.h)
IOT_WIFI_SSID=
IOT_WIFI_PASSWORD=

# FastAPI telemetry host as reachable from the ESP32 (IP/DNS, no URL scheme)
IOT_TELEMETRY_SERVER_HOST=
IOT_TELEMETRY_SERVER_PORT=
# Optional TLS: 1 enables HTTPS; invalid certificates are NOT accepted by default
IOT_USE_HTTPS=0
IOT_TLS_INSECURE=0

# Optional IP/DNS of the separate actuator ESP32, if deployed
IOT_ACTUATOR_HOST=
